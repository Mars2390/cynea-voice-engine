# Cynea Voice Engine — environment template
#
#   cp .env.example .env    then fill in the values below.
#
# .env is gitignored and must stay that way. Never commit a real key.
# cynea/__init__.py loads this file automatically, so importing `cynea`
# is enough for every provider to find its credentials.

# ── Which deployment is this? ───────────
# "production" turns off the public API docs and refuses to build links from
# guesses or to print them. Set it on the deployed API, not on a laptop.
# ENV=production

# ── LLM ─────────────────────────────────
# Free key: https://console.groq.com/keys
# On a laptop this is the model and the transcription. On the Cloudflare socket
# it is transcription only; replies come from CEREBRAS_API_KEY.
GROQ_API_KEY=

# Replies on the Cloudflare socket. Set it there with `pywrangler secret put`;
# only needed here to run voice-worker locally. https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# Optional. Default is openai/gpt-oss-20b.
# NB: this account has no Llama models, so llama-3.3-70b-versatile 404s.
# List what yours has:  GET https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-20b

# ── Speech-to-text ────────────────────────────────────────────────────
# Local Whisper needs no key (pip install openai-whisper + ffmpeg).
# Without it, stt_provider="groq_whisper" reuses GROQ_API_KEY above.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Text-to-speech ────────────────────────────────────────────────────
# edge_tts is free and needs no key — that is the default.
# ElevenLabs is optional and only needed for premium voices.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── API / sessions ────────────────────────────────────────────────────
# Signs session tokens. Without it a random one is generated per process,
# so every restart logs everyone out and multiple workers reject each
# other's tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Keep it stable and secret: changing it signs everyone out and invalidates
# recording links and call tickets.
SESSION_SECRET=
# Comma-separated origins allowed to call the API.
# CORS_ORIGINS=https://cynea.ai

# ── Links in emails ─────────────────────
# Where the pages and the API live, with no trailing slash. Links are built from
# these and never from the request. On Vercel they fall back to the project's
# production domain; on a laptop, to 127.0.0.1.
# SITE_URL=https://cynea.ai
# PUBLIC_API_URL=https://cynea.ai/api

# ── Email ───────────────────────────────
# Resend, free tier: https://resend.com. Sends verification and password-reset
# links. Without it sign-up refuses, because nobody could verify.
EMAIL_API_KEY=
# Resend only sends from a domain you verified with them. Until then its test
# sender can only deliver to your own Resend account's address.
# EMAIL_FROM=Cynea <hello@cynea.ai>
# On a laptop with no key: print links to the terminal. Ignored in production.
# EMAIL_DEV_LOG_LINKS=1

# ── Bot check on sign-up (optional) ─────
# Cloudflare Turnstile, free. Both or neither.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Rate limits (optional) ──────────────
# REGISTER_RATE_LIMIT=5     sign-ups and emails, per IP per hour
# LOGIN_RATE_LIMIT=10       failed sign-ins, per address and IP per 15 minutes

# ── Call recordings ─────────────────────
# Cloudflare R2, free tier: all four, or recordings go to local disk, which does
# not survive on a serverless host.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RECORDINGS_DIR=recordings
# How long tools/purge_recordings.py keeps them.
# RECORDING_RETENTION_DAYS=30

# ── Error tracking (optional) ───────────
# A Sentry DSN (free plan). Unset means errors are only logged.
# SENTRY_DSN=https://<key>@<host>/<project>

# ── Webhooks ────────────────────────────
# Let webhooks reach private addresses, for a receiver on a laptop. Ignored in
# production.
# WEBHOOK_ALLOW_PRIVATE=1

# ── Tests ───────────────────────────────
# Runs tests/test_postgres.py. It DROPS EVERY TABLE: use a throwaway database.
# TEST_POSTGRES_URL=postgresql://postgres:x@localhost:5432/postgres

# ── Database ──────────────────────────────────────────────────────────
# Neon Postgres: https://neon.tech — use the POOLED connection string.
# Then create the schema:  python -m cynea.migrate
DATABASE_URL=
# Local alternative, no Postgres required:
# DATABASE_URL=sqlite:///cynea.db

# ── Twilio voice webhook ────────────────
# POST /api/tel/twilio/voice answers inbound calls with a fixed test message.
# The auth token signs Twilio's requests: without it every call is refused.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Only if the URL in the Twilio Console is not the production one. It must match
# what is pasted there, character for character.
# TWILIO_VOICE_URL=https://cynea-voice-engine.vercel.app/api/tel/twilio/voice

# ── Africa's Talking (not implemented) ─────────
# AT_USERNAME=
# AT_API_KEY=
# AT_PHONE_NUMBER=
# AT_COUNTRY=KE
